{
  "info": {
    "name": "College Chariot API",
    "description": "API documentation for College Chariot Bus Pass Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"1234567890\",\n  \"department\": \"CSE\",\n  \"registrationNumber\": \"20CS01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "User Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe Updated\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Bus Pass",
      "item": [
        {
          "name": "Check Existing Pass",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/buspass/check/20CS01",
              "host": ["{{base_url}}"],
              "path": ["api", "buspass", "check", "20CS01"]
            }
          }
        },
        {
          "name": "Submit Application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "John Doe",
                  "type": "text"
                },
                {
                  "key": "rollNumber",
                  "value": "20CS01",
                  "type": "text"
                },
                {
                  "key": "department",
                  "value": "CSE",
                  "type": "text"
                },
                {
                  "key": "year",
                  "value": "2",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "john@example.com",
                  "type": "text"
                },
                {
                  "key": "phone",
                  "value": "1234567890",
                  "type": "text"
                },
                {
                  "key": "address",
                  "value": "123 Main St",
                  "type": "text"
                },
                {
                  "key": "city",
                  "value": "Hyderabad",
                  "type": "text"
                },
                {
                  "key": "pincode",
                  "value": "500001",
                  "type": "text"
                },
                {
                  "key": "routeNumber",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "boardingPoint",
                  "value": "L.B Nagar",
                  "type": "text"
                },
                {
                  "key": "passDuration",
                  "value": "3",
                  "type": "text"
                },
                {
                  "key": "photo",
                  "type": "file",
                  "src": "/path/to/photo.jpg"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/buspass/apply",
              "host": ["{{base_url}}"],
              "path": ["api", "buspass", "apply"]
            }
          }
        },
        {
          "name": "Create Payment Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationId\": \"{{application_id}}\",\n  \"amount\": 10000\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/buspass/create-payment",
              "host": ["{{base_url}}"],
              "path": ["api", "buspass", "create-payment"]
            }
          }
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{order_id}}\",\n  \"paymentId\": \"{{payment_id}}\",\n  \"signature\": \"{{signature}}\",\n  \"applicationId\": \"{{application_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/buspass/verify-payment",
              "host": ["{{base_url}}"],
              "path": ["api", "buspass", "verify-payment"]
            }
          }
        },
        {
          "name": "Cancel Application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/buspass/cancel/{{application_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "buspass", "cancel", "{{application_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Routes",
      "item": [
        {
          "name": "Get Pending Applications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/buspass/admin/pending",
              "host": ["{{base_url}}"],
              "path": ["api", "buspass", "admin", "pending"]
            }
          }
        },
        {
          "name": "Approve Application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/buspass/admin/approve/{{application_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "buspass", "admin", "approve", "{{application_id}}"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": "your_jwt_token"
    },
    {
      "key": "admin_token",
      "value": "your_admin_jwt_token"
    },
    {
      "key": "application_id",
      "value": "your_application_id"
    },
    {
      "key": "order_id",
      "value": "your_order_id"
    },
    {
      "key": "payment_id",
      "value": "your_payment_id"
    },
    {
      "key": "signature",
      "value": "your_payment_signature"
    }
  ]
} 